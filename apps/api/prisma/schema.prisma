// دعوة / Da3wa — domain model.
//
// Mirrors packages/shared/src/enums.ts. Money is always integer halalas
// (1 SAR = 100 halalas); tax rates are integer basis points (1500 = 15%).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  HOST
  ADMIN
}

enum Locale {
  ar
  en
}

enum EventType {
  WEDDING
  ENGAGEMENT
  GRADUATION
  CORPORATE
  OTHER
}

enum EventStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

/// «قائمة واحدة» vs «رجال / نساء» — the top package sells split guest lists.
enum SectionMode {
  SINGLE
  SPLIT
}

enum GuestSection {
  MEN
  WOMEN
}

/// Where the card artwork comes from — «قالب من الموقع» / «تصميم خاص» / «تصميمي أنا».
///
/// Three sources could always supply artwork (a template, an upload, a pasted
/// URL) and a precedence rule decided between them. That rule is invisible: a
/// host picked a template, uploaded a file to "see how it looks", and could not
/// work out why the template no longer showed. This records which of the three
/// the host actually *chose*, so the answer is a stored decision rather than an
/// inference from which fields happen to be non-null.
enum CardDesignMode {
  /// Pick one of ours. We then tailor it to the event by hand.
  TEMPLATE
  /// We design it from scratch, priced per request.
  CUSTOM_REQUEST
  /// The host brings their own file.
  UPLOAD
}

/// A custom-design job, from «أبغى تصميم خاص» to the finished file.
///
/// REQUESTED → IN_PROGRESS → DELIVERED, or CANCELLED from either. The operator
/// contacts the host off-platform — that conversation is where the design and
/// the price are actually agreed — and the row is what keeps the job from being
/// lost between a WhatsApp thread and a wedding date.
enum DesignRequestStatus {
  REQUESTED
  IN_PROGRESS
  DELIVERED
  CANCELLED
}

/// What kind of drawing the operator owes.
///
/// Both routes to a card end the same way — the operator uploads a file made
/// for this one event — so both live in one queue. What differs is where the
/// work starts and whether it is charged for.
enum DesignRequestKind {
  /// The host picked a template; we adapt it to their names, date and colours.
  /// Included in the package, so it carries no price.
  TEMPLATE_TAILORING
  /// Drawn from scratch to a brief, «بسعر خاص».
  CUSTOM
}

/// NOT_SENT → SENT → OPENED → CONFIRMED | DECLINED → ATTENDED.
/// OPENED is observational, not a gate: SENT → CONFIRMED is legal.
enum GuestStatus {
  NOT_SENT
  SENT
  OPENED
  CONFIRMED
  DECLINED
  ATTENDED
}

enum CheckInMethod {
  QR
  MANUAL
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  MADA
  CREDIT_CARD
  APPLE_PAY
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum OtpPurpose {
  LOGIN
  VERIFY_PHONE
  RESET_PASSWORD
}

enum ActorType {
  USER
  SCAN_USER
  SYSTEM
}

// ─── Identity & auth ─────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  /// E.164, normalized on the way in. Unique because it is the login identifier.
  phone        String   @unique
  passwordHash String
  role         UserRole @default(HOST)
  locale       Locale   @default(ar)
  phoneVerifiedAt DateTime?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events          Event[]
  refreshTokens   RefreshToken[]
  orders          Order[]
  revokedCheckIns CheckIn[]      @relation("CheckInRevokedBy")

  @@index([role])
}

/// One row per issued refresh token.
///
/// Rotation: presenting a token revokes it and issues a successor in the same
/// `family`. Presenting an *already revoked* token means it leaked, so the whole
/// family is revoked at once — a stolen token cannot outlive its own first reuse.
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  /// SHA-256 of the token. The raw value only ever exists in the cookie.
  tokenHash String   @unique
  /// Shared by every token descended from one login.
  family    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?
  /// Set when this token was rotated normally, for chain forensics.
  replacedByTokenId String?
  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
}

model OtpCode {
  id        String     @id @default(cuid())
  /// E.164. Not a User relation — OTP can precede account creation.
  phone     String
  codeHash  String
  purpose   OtpPurpose @default(LOGIN)
  expiresAt DateTime
  consumedAt DateTime?
  /// Verification attempts against this code; the code dies after a few.
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

model Package {
  id             String   @id @default(cuid())
  key            String   @unique
  nameAr         String
  nameEn         String
  /// Maximum guests an event on this package may hold. Enforced, not decorative.
  guestCap       Int
  priceHalalas   Int
  /// How many concurrent scanner sessions the package allows.
  scannerSeats   Int      @default(1)
  featuresAr     String[]
  featuresEn     String[]
  isHighlighted  Boolean  @default(false)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events Event[]
  orders Order[]
}

model Template {
  id              String   @id @default(cuid())
  key             String   @unique
  nameAr          String
  nameEn          String
  category        EventType @default(WEDDING)
  /// An externally hosted preview, for a design that already lives somewhere.
  previewImageUrl String?

  /// The gallery artwork itself, stored like the platform logo and event cards.
  ///
  /// «انا حصمم تصاميم خاصه وارفقها في الموقع» — attaching a design to the site
  /// has to mean uploading a file. A URL column alone would send the operator
  /// hunting for somewhere to host each design first, and the gallery would sit
  /// empty until they did. Served by GET /api/templates/:id/preview.
  previewImageData    Bytes?
  previewImageMime    String?
  /// Bumped on every write so a replaced preview busts any cache holding the old one.
  previewImageVersion Int     @default(0)

  /// Charged on top of the package (the design's +١٩٩ custom-design addon).
  priceHalalas    Int      @default(0)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  events Event[]
}

// ─── Events & guests ─────────────────────────────────────────────────────────

model Event {
  id     String @id @default(cuid())
  hostId String

  title       String
  type        EventType   @default(WEDDING)
  status      EventStatus @default(DRAFT)
  sectionMode SectionMode @default(SINGLE)

  startsAt DateTime
  endsAt   DateTime?
  /// IANA zone. Hijri dates are derived from startsAt at render time, never stored.
  timezone String   @default("Asia/Riyadh")

  /// «اسم صاحب الدعوة» and «الاسم الثاني» — both appear on the card.
  hostName    String
  partnerName String?

  venueName    String?
  venueAddress String?
  venueLat     Float?
  venueLng     Float?
  venueMapUrl  String?

  /// Which of the three routes to a card the host chose. Drives the editor and,
  /// through `resolveArtwork`, which source the guest actually sees.
  cardDesignMode CardDesignMode @default(TEMPLATE)

  templateId    String?
  cardColor     String  @default("#0E5A45")
  cardTitleFont String  @default("amiri")
  /// Set when the host uploaded their own artwork instead of picking a template.
  customCardUrl String?

  /// Uploaded card artwork, stored as bytes like the platform logo.
  ///
  /// On disk it would need a volume the VPS deploy has to remember; in the row
  /// it travels with pg_dump and survives a container rebuild. The route caps
  /// the size hard, so a print-resolution upload cannot bloat the table.
  cardImageData    Bytes?
  cardImageMime    String?
  /// Bumped on every write so a replaced card busts any cache holding the old one.
  cardImageVersion Int     @default(0)

  /// Guests may change their answer until this moment.
  rsvpDeadline DateTime?
  /// Default companion allowance applied to newly added guests.
  defaultCompanionsAllowed Int @default(0)

  /// Shared door password. Null until the host sets one; the scanner gate is
  /// closed while it is null.
  scannerPasswordHash String?

  packageId String?
  /// Overrides the package cap when support grants extra headroom.
  guestCapOverride Int?

  /// WhatsApp message body. {{name}} and {{url}} are substituted per guest.
  whatsappTemplateAr String @default("يشرّفنا حضوركم {{name}}… دعوتكم الخاصة:\n{{url}}")
  whatsappTemplateEn String @default("You're invited, {{name}}. Your personal invitation:\n{{url}}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  host      User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  template  Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  package   Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)

  guests         Guest[]
  guestBatches   GuestBatch[]
  invitations    Invitation[]
  rsvps          RsvpResponse[]
  checkIns       CheckIn[]
  scanUsers      ScanUser[]
  orders         Order[]
  auditLogs      AuditLog[]
  designRequests CustomDesignRequest[]

  @@index([hostId, startsAt])
  @@index([status, startsAt])
}

/// «تصميم خاص» — a design the operator draws for one host.
///
/// Many rows per event rather than one: a host who cancels, or who comes back a
/// month later wanting a second card, must not be blocked by a dead row. The
/// service refuses a *second open* request instead, which is the rule that
/// actually matters.
model CustomDesignRequest {
  id      String @id @default(cuid())
  eventId String

  kind   DesignRequestKind   @default(CUSTOM)
  status DesignRequestStatus @default(REQUESTED)

  /// What the host asked for, in their own words. For a template tailoring it
  /// is the operator's own note of which template was picked.
  notes String?
  /// Where the operator reaches them. Defaults to the account phone, but a host
  /// may hand over a designer's or a family member's number instead.
  contactPhone String

  /// Quoted per request — «بسعر خاص». Null until the operator prices the job.
  /// Frozen into the order's line items at checkout, like every other amount.
  priceHalalas Int?
  /// The operator's own notes and their reply to the host.
  adminNotes String?

  /// Set once a paid order has carried this design's charge, so a later upgrade
  /// order for the same event cannot bill the same design twice.
  billedAt    DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([status, createdAt])
  @@index([kind, status])
}

model Guest {
  id      String @id @default(cuid())
  eventId String

  /// Null while the slot is unclaimed.
  ///
  /// A delegated invitation («ضيوف أم العروس») exists before anyone knows whose
  /// it is: the host mints the slot, the delegate forwards the link, and the
  /// name arrives either from her as she sends it or from the guest at RSVP.
  /// Rendered through `guestDisplayName()` everywhere, so a nameless slot reads
  /// «ضيفنا الكريم» rather than a blank.
  name String?

  /// E.164, and null for the same reason as `name`.
  ///
  /// Unique per event, which is what makes import duplicate detection real —
  /// Postgres treats NULLs as distinct in a unique index, so any number of
  /// unclaimed slots coexist without colliding with each other.
  ///
  /// Every path that builds a `wa.me` link must skip a null: the link needs a
  /// number, and `wa.me/undefined` is a dead link the host would tap once and
  /// never diagnose.
  phone String?

  /// Set when this invitation belongs to a batch someone else distributes.
  batchId String?

  /// «عائلة العريس» / «صديقات العروس» / «زملاء العمل» — an import column, and the
  /// axis of the post-event per-group attendance breakdown.
  group   String?
  section GuestSection?

  companionsAllowed   Int         @default(0)
  /// Chosen by the guest at RSVP time, in the same write as the confirmation.
  companionsConfirmed Int         @default(0)
  status              GuestStatus @default(NOT_SENT)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event      Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  batch      GuestBatch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  invitation Invitation?
  rsvps      RsvpResponse[]
  checkIns   CheckIn[]

  @@unique([eventId, phone])
  @@index([eventId, status])
  @@index([eventId, group])
  @@index([eventId, updatedAt])
  @@index([batchId])
}

/// A block of invitations handed to someone who is not the host.
///
/// The problem it solves is stated best by the host who asked for it: أم العريس
/// cannot invite أم العروس's guests, because she does not have their numbers —
/// but أم العروس does. So the host mints a block of slots, sends *one* message
/// carrying this batch's link, and the delegate distributes the invitations
/// from her own phone, one guest at a time.
///
/// Each slot is still an ordinary Guest with its own Invitation, its own link
/// and its own QR. Nothing about the door, the RSVP or the report changes —
/// only who does the sending.
model GuestBatch {
  id      String @id @default(cuid())
  eventId String

  /// «ضيوف أم العروس» — what the host calls this block.
  label String
  /// Who is distributing it, and where the batch link was sent.
  delegateName  String
  delegatePhone String

  /// The batch page's only credential, minted like an invite token.
  ///
  /// Whoever holds it can see and address this batch's slots — and nothing
  /// else: not the event's other guests, not the host's dashboard. That is the
  /// whole point, and it is why the token is unguessable rather than the batch
  /// id.
  token String @unique

  /// Stamped when the host hands the link over.
  sentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guests Guest[]

  @@index([eventId, createdAt])
}

/// The guest's public link and door credentials.
///
/// Two identifiers on purpose:
///   token       — unguessable nanoid, the /invite/[token] URL. Globally unique.
///   displayCode — short human code ("4821-77") the door staff can type when a
///                 phone screen is cracked. Unique *within an event only*; six
///                 characters would collide constantly if it were global, and the
///                 scanner never resolves one outside its own event.
model Invitation {
  id      String @id @default(cuid())
  guestId String @unique
  /// Denormalized from Guest so displayCode can be scoped and scanner lookups
  /// can hit one index.
  eventId String

  token       String @unique
  displayCode String

  sentAt      DateTime?
  openedAt    DateTime?
  respondedAt DateTime?
  /// Bumped whenever the QR is (re)issued, so an old screenshot can be aged out.
  qrIssuedAt  DateTime?

  remindersSent Int      @default(0)
  lastReminderAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, displayCode])
  @@index([eventId, sentAt])
}

/// Append-only RSVP history. Guest.status is the current projection of this.
model RsvpResponse {
  id      String @id @default(cuid())
  guestId String
  eventId String

  attending  Boolean
  /// Companion count as answered — captured in the same write as `attending`.
  companions Int      @default(0)
  respondedAt DateTime @default(now())

  /// Hashed, not raw — we only need it to spot abuse, never to identify a guest.
  ipHash    String?
  userAgent String?

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([guestId, respondedAt])
  @@index([eventId, respondedAt])
}

/// A door scanner session.
///
/// Created when someone passes the event password at the gate and names
/// themselves («سعود · بوابة الرجال»). Every check-in is attributed to one of
/// these, so an override is always traceable to a person on shift.
model ScanUser {
  id      String @id @default(cuid())
  eventId String

  displayName      String
  sessionTokenHash String @unique

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  userAgent  String?
  ip         String?

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checkIns CheckIn[]

  @@index([eventId, createdAt])
}

/// A guest passing through the door.
///
/// A second scan of the same code does NOT create a row — the scanner reports
/// USED and shows the existing check-in. Admitting anyway is an explicit
/// override: it writes a second row with isOverride = true, pointing at the
/// original via overrideOfId and stamped with the scanner who decided.
///
/// The migration adds a partial unique index enforcing at most one live
/// non-override check-in per guest, so a double-write cannot slip through a race.
model CheckIn {
  id      String @id @default(cuid())
  guestId String
  eventId String

  /// Seats admitted on this scan (guest + companions).
  seats     Int           @default(1)
  scannedAt DateTime      @default(now())
  method    CheckInMethod @default(QR)

  scannedById String

  isOverride   Boolean @default(false)
  overrideOfId String?
  /// Why the scanner admitted a already-used code.
  reason       String?

  revokedAt   DateTime?
  revokedById String?

  createdAt DateTime @default(now())

  guest      Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scannedBy  ScanUser  @relation(fields: [scannedById], references: [id], onDelete: Restrict)
  revokedBy  User?     @relation("CheckInRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  overrideOf CheckIn?  @relation("CheckInOverride", fields: [overrideOfId], references: [id], onDelete: SetNull)
  overrides  CheckIn[] @relation("CheckInOverride")

  @@index([eventId, scannedAt])
  @@index([guestId])
}

// ─── Commerce ────────────────────────────────────────────────────────────────

model Order {
  id          String @id @default(cuid())
  /// DW-2026-4821
  orderNumber String @unique

  userId    String
  eventId   String?
  packageId String?

  status OrderStatus    @default(PENDING)
  method PaymentMethod?

  /// Frozen copy of what was bought — prices must not move when the catalogue does.
  lineItems Json

  subtotalHalalas Int
  discountHalalas Int @default(0)
  /// Basis points: 1500 = 15%.
  vatRateBps      Int @default(1500)
  vatHalalas      Int
  totalHalalas    Int
  currency        String @default("SAR")

  provider    String  @default("stub")
  providerRef String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  event    Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  package  Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([userId, createdAt])
  @@index([status])
}

model Payment {
  id      String @id @default(cuid())
  orderId String

  provider          String
  providerPaymentId String?
  amountHalalas     Int
  status            PaymentStatus @default(PENDING)
  failureReason     String?
  rawPayload        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerPaymentId])
}

/// Inbox for gateway callbacks.
///
/// (provider, providerEventId) is unique so a gateway retrying a webhook — which
/// they all do — cannot double-apply a payment.
model WebhookEvent {
  id              String @id @default(cuid())
  provider        String
  providerEventId String
  type            String
  payload         Json

  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@unique([provider, providerEventId])
  @@index([processedAt])
}

// ─── Audit ───────────────────────────────────────────────────────────────────

model AuditLog {
  id        String    @id @default(cuid())
  actorType ActorType @default(USER)
  actorId   String?
  eventId   String?

  action     String
  targetType String?
  targetId   String?
  meta       Json?
  ip         String?

  createdAt DateTime @default(now())

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([actorType, actorId])
  @@index([action, createdAt])
}

// ─── Platform branding ───────────────────────────────────────────────────────

/// Operator-editable branding, so renaming the product or swapping the logo is
/// an admin action rather than a code change and a deploy.
///
/// Exactly one row, pinned to a known id. A settings *table* with many rows
/// invites the question "which one is live?"; a fixed id makes the read a
/// primary-key lookup that cannot return the wrong answer.
model PlatformSettings {
  /// Always SETTINGS_ID. The check constraint is the fixed default plus the
  /// fact that nothing else ever writes an id here.
  id String @id @default("singleton")

  brandNameAr String @default("دعوة")
  brandNameEn String @default("Da3wa")
  taglineAr   String @default("منصة سعودية للدعوات الرقمية وإدارة حضور المناسبات.")
  taglineEn   String @default("A Saudi platform for digital invitations and event attendance.")

  /// The letter drawn in the emerald square when no logo image is uploaded.
  logoMark String @default("د")

  /// What a custom design costs before the operator quotes a specific job.
  ///
  /// Shown to hosts as a "from" figure and pre-filled into the quote, so the
  /// design doc's +١٩٩ ر.س is an operator setting rather than a constant in the
  /// source. The agreed price still lives on the request row: this is only the
  /// starting point.
  customDesignPriceHalalas Int @default(19900)

  /// The logo lives in the database, not on disk.
  ///
  /// A file on a container filesystem disappears on the next deploy unless a
  /// volume is mounted and remembered; a logo is a handful of kilobytes, and
  /// putting it here means the VPS deploy has one less piece of state to get
  /// right. Served by GET /api/settings/logo.
  logoData Bytes?
  logoMime String?
  /// Bumped on every logo write so caches can be told to refetch.
  logoVersion Int @default(0)

  updatedAt DateTime @updatedAt
}
