# Copy to .env and fill in. Never commit .env.
# Generate each secret with: openssl rand -base64 48

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=da3wa
POSTGRES_PASSWORD=da3wa_dev_password
POSTGRES_DB=da3wa
POSTGRES_PORT=5432
# Used by the API. When running the API on the host (not in compose) against the
# compose postgres, the host is localhost; inside compose it is "postgres".
DATABASE_URL=postgresql://da3wa:da3wa_dev_password@localhost:5432/da3wa?schema=public

# ── API ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# CORS origin allowed to send credentialed requests.
WEB_ORIGIN=http://localhost:3000
# Absolute base used to build public invite URLs (https://yahlainvite.com in production).
PUBLIC_WEB_URL=http://localhost:3000

# ── Auth ────────────────────────────────────────────────────────────────────
# MUST be distinct values. Reusing one secret for both lets an access token be
# replayed as a refresh token.
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ── QR signing ──────────────────────────────────────────────────────────────
# Rotating this invalidates every QR code already delivered to guests.
QR_HMAC_SECRET=change_me_qr_hmac

# ── SMS (OTP) ───────────────────────────────────────────────────────────────
# console = log the code to stdout (dev). Real providers plug in behind SmsProvider.
SMS_PROVIDER=console
# UNIFONIC_APP_SID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# ── Payments ────────────────────────────────────────────────────────────────
# stub    = auto-succeeds locally, contacts nothing.
# moyasar = ميسر, via their hosted invoice page.
PAYMENT_PROVIDER=stub

# How a gateway proves a webhook is really from it.
#   stub    — the key of an HMAC over the raw body.
#   moyasar — the «Secret Token» you set on the webhook in the Moyasar dashboard,
#             which they echo inside every delivery.
# The API refuses to boot on moyasar while this is still a placeholder: it is the
# only thing between a stranger and a POST that marks orders paid. Give each
# deployment its own value — a shared one lets either box settle the other's
# orders.
PAYMENT_WEBHOOK_SECRET=change_me_webhook

# Moyasar keys — dashboard → Settings → API keys. sk_test_/pk_test_ while
# testing, sk_live_/pk_live_ in production; the API refuses to settle a delivery
# whose mode does not match the key. Required when PAYMENT_PROVIDER=moyasar.
# NEVER commit the real values — they belong in .env, which is gitignored.
# MOYASAR_SECRET_KEY=sk_test_your_key_here
# The publishable key is unused by the hosted-invoice flow; kept for the day the
# card form is embedded in our own checkout.
# MOYASAR_PUBLISHABLE_KEY=pk_test_your_key_here

# Then, in the Moyasar dashboard, add a webhook pointing at
#   https://<your-host>/api/webhooks/moyasar
# with the Secret Token above. Without it nothing settles by callback — only the
# check the checkout runs when the payer comes back.
VAT_RATE=0.15
CURRENCY=SAR

# ── Web ─────────────────────────────────────────────────────────────────────
# BUILD-TIME. Next inlines NEXT_PUBLIC_* into the client bundle when the image
# is built, so changing this after the fact does nothing — it must be set before
# `docker build` / `docker compose build`.
#
# In production set it to your public origin (https://your-domain); nginx already
# proxies /api/ to the API. Left at localhost, guests' browsers cannot load the
# QR image or submit an RSVP.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Host ports (production overlay only) ────────────────────────────────────
# Which loopback ports the production containers publish to. Only worth changing
# on a shared VPS where something already holds 3000/4000 — the bind fails
# outright otherwise. Whatever you set here, nginx must proxy to the same values.
WEB_HOST_PORT=3000
API_HOST_PORT=4000
