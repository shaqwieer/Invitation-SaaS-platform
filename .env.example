# Copy to .env and fill in. Never commit .env.
# Generate each secret with: openssl rand -base64 48

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=da3wa
POSTGRES_PASSWORD=da3wa_dev_password
POSTGRES_DB=da3wa
POSTGRES_PORT=5432
# Used by the API. When running the API on the host (not in compose) against the
# compose postgres, the host is localhost; inside compose it is "postgres".
DATABASE_URL=postgresql://da3wa:da3wa_dev_password@localhost:5432/da3wa?schema=public

# ── API ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# CORS origin allowed to send credentialed requests.
WEB_ORIGIN=http://localhost:3000
# Absolute base used to build public invite URLs (https://da3wa.sa in production).
PUBLIC_WEB_URL=http://localhost:3000

# ── Auth ────────────────────────────────────────────────────────────────────
# MUST be distinct values. Reusing one secret for both lets an access token be
# replayed as a refresh token.
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ── QR signing ──────────────────────────────────────────────────────────────
# Rotating this invalidates every QR code already delivered to guests.
QR_HMAC_SECRET=change_me_qr_hmac

# ── SMS (OTP) ───────────────────────────────────────────────────────────────
# console = log the code to stdout (dev). Real providers plug in behind SmsProvider.
SMS_PROVIDER=console
# UNIFONIC_APP_SID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# ── Payments ────────────────────────────────────────────────────────────────
# stub = auto-succeeds locally. Real gateways plug in behind PaymentProvider.
PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=change_me_webhook
VAT_RATE=0.15
CURRENCY=SAR

# ── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
